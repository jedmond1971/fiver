# Supabase project config (see README for setup steps).
# Copy this file to `.env` and fill in real values — `.env` is gitignored.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-side (api/) copies of the two vars above — api/ runs under plain
# Node, not Vite, so it can't read import.meta.env. Same values as the
# VITE_ ones.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Secret. Supabase dashboard -> Project Settings -> API -> service_role.
# Used by api/invite.ts to create accounts via admin.inviteUserByEmail().
# Never prefix this with VITE_ or it will ship to the browser bundle.
SUPABASE_SERVICE_ROLE_KEY=
